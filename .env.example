# Spotify API (get from https://developer.spotify.com/dashboard)
# 1. Go to https://developer.spotify.com/dashboard
# 2. Create a new app
# 3. Copy the Client ID
# 4. Add http://127.0.0.1:3000/Spotify-Webapp-Visualizer/callback to Redirect URIs
VITE_SPOTIFY_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# YouTube search is now FREE via Browser-Use API!
# No API key needed - no quota limits!

# (Optional) Backend API URL for production
# VITE_API_URL=https://your-backend.railway.app

